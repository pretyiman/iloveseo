ENV=development

DATABASE_URL=postgresql+asyncpg://seokit:seokit@localhost:5432/seokit

# Clerk: Dashboard -> API Keys -> Advanced -> JWKS URL, or
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_ISSUER=

# Clerk Backend API secret key (Dashboard -> API Keys -> Secret keys) --
# same value as apps/web's CLERK_SECRET_KEY. Needed to fetch the user's
# Google OAuth access token for sending monitoring reports via Gmail.
CLERK_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=

# Google PageSpeed Insights API key -- used by the Speed Test tool.
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

REDIS_URL=redis://localhost:6380/0
RENDER_SIDECAR_URL=http://localhost:4000

# GEO/AI-visibility tracker. Each is independently optional -- a check
# just reports "not configured" for whichever provider's key is missing.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]
